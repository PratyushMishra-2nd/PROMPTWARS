# Gemini AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here

# Models
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGIN=http://localhost:3000

# Optional: Google Cloud services (all FREE within hackathon limits)
# GCP_PROJECT_ID=
# Document AI OCR for scanned PDFs (1000 pages/mo free)
# DOCAI_PROCESSOR_ID=projects/PROJECT/locations/us/processors/PROCESSOR_ID
# DOCAI_LOCATION=us
# Cloud Text-to-Speech (4M chars/mo free) — listen-to-clause endpoint
# ENABLE_TTS=1
# Cloud Translation (500k chars/mo free) — auto-translate non-English contracts
# ENABLE_TRANSLATION=1
# Cloud Logging — structured logs to GCP (50GB/mo free)
# ENABLE_CLOUD_LOGGING=1
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
